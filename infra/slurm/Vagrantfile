Vagrant.configure("2") do |config|

  # Project resides on WSL ext4.
  # VirtualBox runs on Windows, so the default /vagrant
  # synced folder cannot be used.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.box = "ubuntu/jammy64"

  # WSL cannot reach VirtualBox's Windows-loopback SSH forwarding
  # through 127.0.0.1. We explicitly connect through the Windows
  # host/gateway address visible from WSL.
  windows_host_ip = ENV.fetch(
    "VAGRANT_WSL_HOST_IP"
  )

  config.vm.provider "virtualbox" do |vb|
    vb.gui = false

    # Ubuntu box UART logging points to /dev/null.
    # VirtualBox itself is running on Windows, where /dev/null
    # does not exist.
    vb.customize [
      "modifyvm",
      :id,
      "--uartmode1",
      "disconnected"
    ]
  end

  nodes = {
    "slurm-controller" => {
      ip: "192.168.56.20",
      ssh_port: 2222,
      cpus: 2,
      memory: 2048
    },

    "slurm-compute01" => {
      ip: "192.168.56.21",
      ssh_port: 2223,
      cpus: 2,
      memory: 2048
    },

    "slurm-compute02" => {
      ip: "192.168.56.22",
      ssh_port: 2224,
      cpus: 2,
      memory: 2048
    }
  }

  nodes.each do |name, node|

    config.vm.define name do |machine|

      machine.vm.hostname = name

      machine.vm.network \
        "private_network",
        ip: node[:ip]

      # Bind SSH forwarding on the Windows host interfaces rather
      # than only Windows localhost.
      machine.vm.network \
        "forwarded_port",
        guest: 22,
        host: node[:ssh_port],
        host_ip: "0.0.0.0",
        id: "ssh",
        auto_correct: false

      # Tell Vagrant-in-WSL to contact the Windows host address.
      machine.ssh.host = windows_host_ip
      machine.ssh.guest_port = 22

      machine.vm.provider "virtualbox" do |vb|
        vb.name = name
        vb.cpus = node[:cpus]
        vb.memory = node[:memory]
      end

      machine.vm.provision "shell", inline: <<-SHELL
        set -e

        grep -q 'slurm-controller' /etc/hosts || \
          echo "192.168.56.20 slurm-controller" >> /etc/hosts

        grep -q 'slurm-compute01' /etc/hosts || \
          echo "192.168.56.21 slurm-compute01" >> /etc/hosts

        grep -q 'slurm-compute02' /etc/hosts || \
          echo "192.168.56.22 slurm-compute02" >> /etc/hosts

        apt-get update -y

        apt-get install -y \
          curl \
          vim \
          htop \
          jq \
          chrony

        systemctl enable --now chrony
      SHELL
    end

  end
end
